LOG_LEVEL=INFO
# POST /extract (TP de carga): procesos de conversión por réplica y backpressure.
EXTRACT_WORKERS=1
EXTRACT_MAX_QUEUE=100
EXTRACT_QUEUE_TIMEOUT_SECONDS=25
# Puerto del host donde el proxy del docker-compose.yml publica el servicio.
PUERTO=8080
CONSUL_ENABLED=true
CONSUL_HTTP_ADDR=http://consul:8500
CONSUL_HTTP_TOKEN_FILE=/run/secrets/consul_microservices_token
CONSUL_SERVICE_ADDRESS=extraccion
CONSUL_SERVICE_PORT=8000
